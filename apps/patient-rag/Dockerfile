    DRIFTLINE_CONFIG_DIR=/src/config \
    PYTHONUNBUFFERED=1 \
    PATIENT_RAG_HOME=/src/apps/patient-rag \
    CORPUS_DIR=/src/data/corpus \
    GIT_COMMIT=${GIT_COMMIT}
USER app
EXPOSE 8000
CMD ["uvicorn", "patient_rag.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
