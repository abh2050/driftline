// The Driftline workbook (spec 8.2), generated by scripts/gen_workbook.py.
param location string
param tags object
param workspaceId string

resource workbook 'Microsoft.Insights/workbooks@2023-06-01' = {
  name: guid(resourceGroup().id, 'driftline-workbook')
  location: location
  tags: tags
  kind: 'shared'
  properties: {
    displayName: 'Driftline'
    category: 'workbook'
    sourceId: workspaceId
    serializedData: replace(loadTextContent('../workbooks/driftline.json'), '{WorkspaceId}', workspaceId)
  }
}

output id string = workbook.id
