ENV PATH=/src/.venv/bin:$PATH \
    DRIFTLINE_CONFIG_DIR=/src/config \
    PYTHONUNBUFFERED=1
USER app
EXPOSE 8000
CMD ["uvicorn", "detector.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
