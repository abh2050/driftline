        { "name": "text-embedding-3-small", "model": "text-embedding-3-small", "version": "1", "format": "OpenAI", "sku": "GlobalStandard", "capacity": 300 },
        { "name": "text-embedding-3-large", "model": "text-embedding-3-large", "version": "1", "format": "OpenAI", "sku": "Standard", "capacity": 100 },
        { "name": "cohere-rerank-fast", "model": "Cohere-rerank-v4.0-fast", "version": "1", "format": "Cohere", "sku": "GlobalStandard", "capacity": 20 },
        { "name": "cohere-rerank-pro", "model": "Cohere-rerank-v4.0-pro", "version": "1", "format": "Cohere", "sku": "GlobalStandard", "capacity": 20 }
      ]
